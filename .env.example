# ===== Salin ke .env lalu ubah semua nilai CHANGE_ME =====

# --- Postgres ---
POSTGRES_USER=wagw
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=wagw

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_redis_password

# --- App (dipakai web & worker) ---
# Lewat PgBouncer (transaction mode). Host "pgbouncer" = nama service compose.
DATABASE_URL=postgres://wagw:CHANGE_ME_strong_password@pgbouncer:6432/wagw
# Langsung ke Postgres, khusus migrasi
DATABASE_URL_DIRECT=postgres://wagw:CHANGE_ME_strong_password@postgres:5432/wagw
REDIS_URL=redis://:CHANGE_ME_redis_password@redis:6379

TZ_APP=Asia/Jakarta
LOG_LEVEL=info
SESSION_TTL_DAYS=7
# true jika diakses lewat HTTPS (WAJIB true di produksi)
COOKIE_SECURE=true

# Akun superadmin pertama (dibuat otomatis saat migrate jika belum ada)
SEED_SUPERADMIN_EMAIL=admin@example.com
SEED_SUPERADMIN_PASSWORD=CHANGE_ME_min8chars

# Port web di host (hanya 127.0.0.1, diakses lewat nginx global)
WEB_PORT=3000
