# ===== Salin ke .env lalu ubah semua nilai CHANGE_ME =====
# Mode PRODUKSI (docker-compose.yml): menempel ke infra repo devops.
# Host di bawah adalah NAMA CONTAINER di devops — jangan diganti IP.

# --- Database (dibuat oleh: devops/scripts/create-app-db.sh wa_gateway) ---
# Lewat PgBouncer (transaction mode) — dipakai web & worker
DATABASE_URL=postgres://wa_gateway:CHANGE_ME_db_password@infra_pgbouncer:5432/wa_gateway
# Langsung ke Postgres — khusus migrasi
DATABASE_URL_DIRECT=postgres://wa_gateway:CHANGE_ME_db_password@infra_postgres:5432/wa_gateway
DB_POOL_MAX=10

# --- Redis QUEUE (bukan redis cache!) — password = REDIS_QUEUE_PASSWORD di devops/01-infra/.env ---
REDIS_URL=redis://:CHANGE_ME_redis_queue_password@infra_redis_queue:6379

TZ_APP=Asia/Jakarta
LOG_LEVEL=info
SESSION_TTL_DAYS=7
# true jika diakses lewat HTTPS (WAJIB true di produksi)
COOKIE_SECURE=true

# Akun superadmin pertama (dibuat otomatis saat migrate jika belum ada)
SEED_SUPERADMIN_EMAIL=admin@example.com
SEED_SUPERADMIN_PASSWORD=CHANGE_ME_min8chars

# ===== Hanya untuk docker-compose.standalone.yml =====
# POSTGRES_USER=wagw
# POSTGRES_PASSWORD=CHANGE_ME
# POSTGRES_DB=wagw
# REDIS_PASSWORD=CHANGE_ME
# WEB_PORT=3000
# (dan ganti host di URL atas menjadi pgbouncer:6432 / postgres:5432 / redis:6379)
